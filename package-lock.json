{
  "name": "blueline-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "blueline-monorepo",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@bluelinecli/binary-linux-x64-gnu": {
      "version": "0.1.0",
      "resolved": "https://registry.npmjs.org/@bluelinecli/binary-linux-x64-gnu/-/binary-linux-x64-gnu-0.1.0.tgz",
      "integrity": "sha512-zBtMKtsxJRFF6CT2Czj2+rNPwMOtHzMXFEwqzimrzL7tflUatJdqE1ob9KM9q4sG9R3Y9vXPkE4ItY17z3UGKg==",
      "cpu": [
        "x64"
      ],
      "license": "MIT",
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "node_modules/@bluelinecli/cli": {
      "resolved": "packages/blueline",
      "link": true
    },
    "node_modules/blueline": {
      "resolved": "packages/npx",
      "link": true
    },
    "packages/blueline": {
      "name": "@bluelinecli/cli",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "blueline": "bin/blueline.js"
      },
      "engines": {
        "node": ">=18.0.0"
      },
      "optionalDependencies": {
        "@bluelinecli/binary-linux-x64-gnu": "*"
      }
    },
    "packages/npx": {
      "name": "blueline",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "blueline": "bin/blueline.js"
      },
      "engines": {
        "node": ">=18.0.0"
      },
      "optionalDependencies": {
        "@bluelinecli/binary-linux-x64-gnu": "*"
      }
    }
  }
}
