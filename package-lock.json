{
  "name": "blueline-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "blueline-monorepo",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@kridaydave/blueline-cli": {
      "resolved": "packages/blueline",
      "link": true
    },
    "node_modules/blueline-cli": {
      "resolved": "packages/npx",
      "link": true
    },
    "packages/blueline": {
      "name": "@kridaydave/blueline-cli",
      "version": "0.3.0",
      "license": "MIT",
      "bin": {
        "blueline": "bin/blueline.js"
      },
      "engines": {
        "node": ">=18.0.0"
      },
      "optionalDependencies": {
        "@kridaydave/binary-darwin-arm64": "*",
        "@kridaydave/binary-darwin-x64": "*",
        "@kridaydave/binary-linux-arm64-gnu": "*",
        "@kridaydave/binary-linux-arm64-musl": "*",
        "@kridaydave/binary-linux-x64-gnu": "*",
        "@kridaydave/binary-linux-x64-musl": "*",
        "@kridaydave/binary-win32-arm64": "*",
        "@kridaydave/binary-win32-x64": "*"
      }
    },
    "packages/npx": {
      "name": "blueline-cli",
      "version": "0.3.0",
      "license": "MIT",
      "bin": {
        "blueline": "bin/blueline.js"
      },
      "engines": {
        "node": ">=18.0.0"
      },
      "optionalDependencies": {
        "@kridaydave/binary-darwin-arm64": "*",
        "@kridaydave/binary-darwin-x64": "*",
        "@kridaydave/binary-linux-arm64-gnu": "*",
        "@kridaydave/binary-linux-arm64-musl": "*",
        "@kridaydave/binary-linux-x64-gnu": "*",
        "@kridaydave/binary-linux-x64-musl": "*",
        "@kridaydave/binary-win32-arm64": "*",
        "@kridaydave/binary-win32-x64": "*"
      }
    }
  }
}
